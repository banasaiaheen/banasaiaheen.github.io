# EmailJS credentials — copy this file to ".env" and fill in your real values.
# Get these from your EmailJS dashboard: https://dashboard.emailjs.com/admin
#
# Vite only exposes env vars prefixed with VITE_ to client-side code, and
# never commit the real ".env" file (it's already in .gitignore).

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
